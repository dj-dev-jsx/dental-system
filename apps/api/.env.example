# The running API: limited login that can read and write rows only.
DATABASE_URL=postgresql://dental_app:change-me-too@127.0.0.1:5432/dental_clinic

# Prisma migrations only: the owner login that can change tables.
MIGRATION_DATABASE_URL=postgresql://dental_owner:change-me@127.0.0.1:5432/dental_clinic

# Automated tests use their own database, so they can't touch development data.
TEST_DATABASE_URL=postgresql://dental_app:change-me-too@127.0.0.1:5432/dental_clinic_test
TEST_MIGRATION_DATABASE_URL=postgresql://dental_owner:change-me@127.0.0.1:5432/dental_clinic_test

# Password for the fake staff created by `pnpm --filter api db:seed`. Development only.
SEED_PASSWORD=change-me-too-please
