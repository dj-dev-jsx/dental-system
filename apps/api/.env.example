# The running API: limited login that can read and write rows only.
DATABASE_URL=postgresql://dental_app:change-me-too@127.0.0.1:5432/dental_clinic

# Prisma migrations only: the owner login that can change tables.
MIGRATION_DATABASE_URL=postgresql://dental_owner:change-me@127.0.0.1:5432/dental_clinic

# Automated tests use their own database, so they can't touch development data.
TEST_DATABASE_URL=postgresql://dental_app:change-me-too@127.0.0.1:5432/dental_clinic_test
TEST_MIGRATION_DATABASE_URL=postgresql://dental_owner:change-me@127.0.0.1:5432/dental_clinic_test

# Password for the fake staff created by `pnpm --filter api db:seed`. Development only.
SEED_PASSWORD=change-me-too-please

# --- Email (online booking) ---
# Leave RESEND_API_KEY empty in development: emails then go to Mailpit
# (docker compose up -d mailpit, read them at http://localhost:8025) and never reach anyone.
# With a key, emails are really sent through Resend (resend.com). Required in production.
# Resend's test sender, onboarding@resend.dev, only delivers to the Resend account owner's
# own email address; real patients need a domain verified in Resend.
RESEND_API_KEY=
# Who emails come from. Required in production, on the domain verified in Resend, like
# "Sample Dental Clinic <bookings@sampleclinic.ph>". Just an address shows it under the
# clinic's name. Empty in development means "<clinic name> <no-reply@localhost>".
MAIL_FROM=
# Mailpit's SMTP address. Only used when RESEND_API_KEY is empty, outside production.
SMTP_URL=smtp://localhost:1025
# The web app, for the links in emails. Required in production.
WEB_ORIGIN=http://localhost:5173
