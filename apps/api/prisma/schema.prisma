generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Conventions for every table:
//  - ids are UUID v7: not guessable, and time-ordered so indexes stay fast.
//  - Times are timestamptz, which stores an exact moment rather than a clock reading.
//  - Anything owned by a clinic has clinic_id and @@unique([clinicId, id]), so later tables
//    can use a two-column foreign key that stops the database linking rows across clinics.
//  - onDelete: Restrict. Deleting a clinic or user must never erase medical records.
//  - A table holding patient data needs row-level security too. Prisma can't express that
//    here, so its migration adds it by hand: copy the end of the add_patient_row_level_security
//    migration. A test fails if a table with clinic_id doesn't have it.

enum UserRole {
  ADMIN
  DENTIST
  RECEPTIONIST
  ASSISTANT
}

enum Sex {
  FEMALE
  MALE
}

enum AuditAction {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  PATIENT_CREATED
  PATIENT_LISTED
  PATIENT_VIEWED
  PATIENT_UPDATED
  PATIENT_ARCHIVED
  PATIENT_RESTORED
  APPOINTMENT_CREATED
  APPOINTMENT_LISTED
  APPOINTMENT_VIEWED
  APPOINTMENT_UPDATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_DECLINED
  APPOINTMENT_CANCELLED
  CHART_VIEWED
  TOOTH_RECORDED
  TOOTH_CORRECTED
}

// What a dentist found or did to a whole tooth. The 3D chart colours each tooth by its latest one.
enum ToothCondition {
  HEALTHY
  DECAYED
  FILLED
  CROWN
  ROOT_CANAL
  IMPLANT
  MISSING
  EXTRACTED
}

// The sides of a tooth, for decay and fillings. Occlusal means the biting surface
// (on front teeth it's called incisal); buccal is the cheek or lip side, lingual the tongue side.
enum ToothSurface {
  MESIAL
  DISTAL
  OCCLUSAL
  BUCCAL
  LINGUAL
}

// REQUESTED: asked for, waiting for the clinic. CONFIRMED: booked, and the dentist's time is
// taken. DECLINED: the clinic said no to a request. CANCELLED: called off after all.
enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
}

model Clinic {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(200)
  address   String?  @db.VarChar(500)
  phone     String?  @db.VarChar(30)
  email     String?  @db.VarChar(254)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users        User[]
  patients     Patient[]
  auditLogs    AuditLog[]
  appointments Appointment[]
  toothRecords ToothRecord[]

  @@map("clinics")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  clinicId     String   @map("clinic_id") @db.Uuid
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  role         UserRole
  // Staff who leave are deactivated, never deleted: records still point to them.
  isActive     Boolean  @default(true) @map("is_active")
  // After too many wrong passwords the account is locked for a while.
  failedLogins Int      @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  sessions     Session[]
  auditLogs    AuditLog[]
  appointments Appointment[]
  toothRecords ToothRecord[]

  @@unique([clinicId, id])
  @@map("users")
}

// One row per logged-in device. Deleting the row ends that login immediately.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  // SHA-256 of the cookie's token, so a leaked database copy can't be used to log in.
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Sessions aren't medical records, so unlike everything else these may be deleted.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Patient {
  id                    String    @id @default(uuid(7)) @db.Uuid
  clinicId              String    @map("clinic_id") @db.Uuid
  firstName             String    @map("first_name") @db.VarChar(100)
  middleName            String?   @map("middle_name") @db.VarChar(100)
  lastName              String    @map("last_name") @db.VarChar(100)
  suffix                String?   @db.VarChar(20)
  birthDate             DateTime  @map("birth_date") @db.Date
  sex                   Sex?
  phone                 String?   @db.VarChar(30)
  email                 String?   @db.VarChar(254)
  address               String?   @db.VarChar(500)
  emergencyContactName  String?   @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactPhone String?   @map("emergency_contact_phone") @db.VarChar(30)
  // When the patient agreed to the clinic's privacy notice (Data Privacy Act).
  privacyConsentAt      DateTime? @map("privacy_consent_at") @db.Timestamptz(3)
  // Patients are archived, never deleted: dental records must be kept.
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  toothRecords ToothRecord[]

  @@unique([clinicId, id])
  @@index([clinicId, lastName, firstName])
  @@map("patients")
}

// Who did what, and when. The API's database login can only add and read rows here, so
// nobody can quietly edit or remove the history through the app.
// Updates keep each changed field's old and new value, so this table holds patient details
// and needs the same protection as the patient records themselves.
model AuditLog {
  id          String      @id @default(uuid(7)) @db.Uuid
  clinicId    String      @map("clinic_id") @db.Uuid
  // For a login or logout, the account that was used.
  actorUserId String      @map("actor_user_id") @db.Uuid
  action      AuditAction
  // The record acted on. Empty when an action covers many records, like a search.
  entityId    String?     @map("entity_id") @db.Uuid
  // Details of the action: an update's { changes: { field: { from, to } } }, or why a login failed.
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // Two columns, so the database refuses a log entry whose actor is from another clinic.
  actor  User   @relation(fields: [clinicId, actorUserId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([clinicId, entityId, createdAt])
  @@index([clinicId, createdAt])
  @@map("audit_logs")
}

// A visit to one dentist at one time. Its migration adds rules Prisma can't write here:
//  - ends_at must come after starts_at;
//  - a confirmed appointment must have a dentist;
//  - two confirmed appointments for the same dentist can never overlap (an "exclusion
//    constraint"), so even two receptionists booking the same slot at the same moment
//    can't double-book. Requests may overlap: they don't take up the dentist's time yet.
// Who created or changed an appointment is in the audit log, like everything else.
model Appointment {
  id         String            @id @default(uuid(7)) @db.Uuid
  clinicId   String            @map("clinic_id") @db.Uuid
  patientId  String            @map("patient_id") @db.Uuid
  // Empty only for a request where the patient didn't mind which dentist.
  dentistId  String?           @map("dentist_id") @db.Uuid
  startsAt   DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime          @map("ends_at") @db.Timestamptz(3)
  status     AppointmentStatus @default(REQUESTED)
  // What the visit is for, like "Cleaning" or "Tooth ache, lower left".
  reason     String?           @db.VarChar(500)
  // Why it was declined or cancelled.
  statusNote String?           @map("status_note") @db.VarChar(500)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // Two columns each, so the patient and the dentist must belong to the same clinic.
  patient Patient @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  dentist User?   @relation(fields: [clinicId, dentistId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)

  toothRecords ToothRecord[]

  @@unique([clinicId, id])
  // Lets a chart entry name the visit it was made in, and the database check it's this patient's.
  @@unique([clinicId, patientId, id])
  @@index([clinicId, startsAt])
  @@index([clinicId, patientId, startsAt])
  @@index([clinicId, status, startsAt])
  @@map("appointments")
}

// One entry in a patient's dental chart: what was found on one tooth, by whom, and when.
// Entries are permanent, like a paper chart written in pen: the API's login can add them but
// never change or delete them. A mistake is fixed by a correction, a new entry that points at
// the wrong one and says why; the wrong one stays in the history. Its migration adds checks
// Prisma can't write here (see the end of add_dental_chart).
model ToothRecord {
  id               String          @id @default(uuid(7)) @db.Uuid
  clinicId         String          @map("clinic_id") @db.Uuid
  patientId        String          @map("patient_id") @db.Uuid
  // FDI number, "11" to "48". Baby teeth ("51" to "85") come later.
  tooth            String          @db.VarChar(2)
  // Empty only on a correction that withdraws an entry with nothing in its place.
  condition        ToothCondition?
  surfaces         ToothSurface[]
  note             String?         @db.VarChar(1000)
  recordedById     String          @map("recorded_by_id") @db.Uuid
  // The visit it was recorded in, when there was one.
  appointmentId    String?         @map("appointment_id") @db.Uuid
  // When the finding was made. A correction keeps the date of the entry it corrects, so it
  // takes that entry's place in the tooth's timeline rather than looking like a new finding.
  recordedAt       DateTime        @map("recorded_at") @db.Timestamptz(3)
  correctsId       String?         @unique @map("corrects_id") @db.Uuid
  correctionReason String?         @map("correction_reason") @db.VarChar(500)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  patient     Patient      @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  recordedBy  User         @relation(fields: [clinicId, recordedById], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  // Three columns, so the visit must be this patient's, in this clinic.
  appointment Appointment? @relation(fields: [clinicId, patientId, appointmentId], references: [clinicId, patientId, id], onDelete: Restrict, onUpdate: Restrict)
  // Four columns, so a correction can only correct the same patient's same tooth.
  corrects    ToothRecord? @relation("Correction", fields: [clinicId, patientId, tooth, correctsId], references: [clinicId, patientId, tooth, id], onDelete: Restrict, onUpdate: Restrict)
  correctedBy ToothRecord? @relation("Correction")

  @@unique([clinicId, id])
  @@unique([clinicId, patientId, tooth, id])
  @@unique([clinicId, patientId, tooth, correctsId])
  @@index([clinicId, patientId, tooth, recordedAt])
  @@map("tooth_records")
}
