generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Conventions for every table:
//  - ids are UUID v7: not guessable, and time-ordered so indexes stay fast.
//  - Times are timestamptz, which stores an exact moment rather than a clock reading.
//  - Anything owned by a clinic has clinic_id and @@unique([clinicId, id]), so later tables
//    can use a two-column foreign key that stops the database linking rows across clinics.
//  - onDelete: Restrict. Deleting a clinic or user must never erase medical records.
//  - A table holding patient data needs row-level security too. Prisma can't express that
//    here, so its migration adds it by hand: copy the end of the add_patient_row_level_security
//    migration. A test fails if a table with clinic_id doesn't have it.

enum UserRole {
  ADMIN
  DENTIST
  RECEPTIONIST
  ASSISTANT
}

enum Sex {
  FEMALE
  MALE
}

enum AuditAction {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  PATIENT_CREATED
  PATIENT_LISTED
  PATIENT_VIEWED
  PATIENT_UPDATED
  PATIENT_ARCHIVED
  PATIENT_RESTORED
}

model Clinic {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(200)
  address   String?  @db.VarChar(500)
  phone     String?  @db.VarChar(30)
  email     String?  @db.VarChar(254)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users     User[]
  patients  Patient[]
  auditLogs AuditLog[]

  @@map("clinics")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  clinicId     String   @map("clinic_id") @db.Uuid
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  role         UserRole
  // Staff who leave are deactivated, never deleted: records still point to them.
  isActive     Boolean  @default(true) @map("is_active")
  // After too many wrong passwords the account is locked for a while.
  failedLogins Int      @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  sessions  Session[]
  auditLogs AuditLog[]

  @@unique([clinicId, id])
  @@map("users")
}

// One row per logged-in device. Deleting the row ends that login immediately.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  // SHA-256 of the cookie's token, so a leaked database copy can't be used to log in.
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Sessions aren't medical records, so unlike everything else these may be deleted.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Patient {
  id                    String    @id @default(uuid(7)) @db.Uuid
  clinicId              String    @map("clinic_id") @db.Uuid
  firstName             String    @map("first_name") @db.VarChar(100)
  middleName            String?   @map("middle_name") @db.VarChar(100)
  lastName              String    @map("last_name") @db.VarChar(100)
  suffix                String?   @db.VarChar(20)
  birthDate             DateTime  @map("birth_date") @db.Date
  sex                   Sex?
  phone                 String?   @db.VarChar(30)
  email                 String?   @db.VarChar(254)
  address               String?   @db.VarChar(500)
  emergencyContactName  String?   @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactPhone String?   @map("emergency_contact_phone") @db.VarChar(30)
  // When the patient agreed to the clinic's privacy notice (Data Privacy Act).
  privacyConsentAt      DateTime? @map("privacy_consent_at") @db.Timestamptz(3)
  // Patients are archived, never deleted: dental records must be kept.
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@unique([clinicId, id])
  @@index([clinicId, lastName, firstName])
  @@map("patients")
}

// Who did what, and when. The API's database login can only add and read rows here, so
// nobody can quietly edit or remove the history through the app.
// Updates keep each changed field's old and new value, so this table holds patient details
// and needs the same protection as the patient records themselves.
model AuditLog {
  id          String      @id @default(uuid(7)) @db.Uuid
  clinicId    String      @map("clinic_id") @db.Uuid
  // For a login or logout, the account that was used.
  actorUserId String      @map("actor_user_id") @db.Uuid
  action      AuditAction
  // The record acted on. Empty when an action covers many records, like a search.
  entityId    String?     @map("entity_id") @db.Uuid
  // Details of the action: an update's { changes: { field: { from, to } } }, or why a login failed.
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // Two columns, so the database refuses a log entry whose actor is from another clinic.
  actor  User   @relation(fields: [clinicId, actorUserId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([clinicId, entityId, createdAt])
  @@index([clinicId, createdAt])
  @@map("audit_logs")
}
